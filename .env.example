# Скопируйте в .env на сервере: cp .env.example .env && nano .env
POSTGRES_USER=wlc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wlc

# Админка: https://welegalcompliance.itb2bhost.ru/admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin-password
# Случайная строка для подписи сессий: openssl rand -hex 32
SECRET_KEY=change-me

# Порты на localhost сервера, которые проксирует nginx
API_PORT=8100
WEB_PORT=3100

# Лимиты открытой версии
MAX_PAGES=30
RATE_LIMIT_PER_HOUR=10
WORKER_CONCURRENCY=2

# Скопируйте в .env на сервере: cp .env.example .env && nano .env
POSTGRES_USER=wlc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wlc

# Админка: https://weblegalcompliance.itb2bhost.ru/admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin-password
# Случайная строка для подписи сессий: openssl rand -hex 32
SECRET_KEY=change-me

# Порты на localhost сервера, которые проксирует nginx
API_PORT=8100
WEB_PORT=3100

# Лимиты открытой версии
MAX_PAGES=50
RATE_LIMIT_PER_HOUR=10
# На сервере с 2 ГБ RAM — одна проверка за раз (браузер занимает 500–800 МБ)
WORKER_CONCURRENCY=1
# Вкладок браузера на одну проверку (~1 на ядро CPU)
PARALLEL_TABS=2
# Внутренние страницы без JavaScript грузить HTTP-запросом (в 3–4 раза быстрее)
FAST_FETCH=true

# Адрес набора «Реестр операторов ПДн» в открытых данных РКН (если РКН его сменит)
# RKN_OPENDATA_URL=https://rkn.gov.ru/opendata/7705846236-OperatorsPD/
